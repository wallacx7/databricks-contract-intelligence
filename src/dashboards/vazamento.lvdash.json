{
  "datasets": [
    {
      "name": "resumo",
      "displayName": "Resumo do vazamento",
      "queryLines": [
        "SELECT\n",
        "  (SELECT count(DISTINCT contrato_id) FROM termos_mensais) AS contratos_analisados,\n",
        "  count(DISTINCT contrato_id) AS contratos_com_vazamento,\n",
        "  sum(vazamento_acumulado) AS vazamento_acumulado,\n",
        "  sum(vazamento_mes_atual) AS vazamento_mes_atual,\n",
        "  sum(recuperavel_12_meses) AS recuperavel_12_meses\n",
        "FROM vazamento_por_contrato\n"
      ]
    },
    {
      "name": "por_tipo",
      "displayName": "Vazamento por tipo",
      "queryLines": [
        "SELECT CASE tipo WHEN 'desconto_vencido' THEN 'Desconto vencido' WHEN 'preco_abaixo' THEN 'Preço abaixo do contratado' WHEN 'reajuste_nao_aplicado' THEN 'Reajuste não aplicado' ELSE 'Mínimo não cobrado' END AS tipo, sum(vazamento_acumulado) AS vazamento_acumulado, count(DISTINCT contrato_id) AS contratos\n",
        "FROM vazamento_por_contrato GROUP BY 1\n"
      ]
    },
    {
      "name": "mensal",
      "displayName": "Vazamento mensal",
      "queryLines": [
        "SELECT mes, CASE tipo WHEN 'desconto_vencido' THEN 'Desconto vencido' WHEN 'preco_abaixo' THEN 'Preço abaixo do contratado' WHEN 'reajuste_nao_aplicado' THEN 'Reajuste não aplicado' ELSE 'Mínimo não cobrado' END AS tipo, sum(vazamento) AS vazamento\n",
        "FROM vazamento_mensal\n",
        "WHERE mes >= add_months((SELECT max(mes) FROM vazamento_mensal), -23)\n",
        "GROUP BY 1, 2\n"
      ]
    },
    {
      "name": "contratos",
      "displayName": "Maiores vazamentos",
      "queryLines": [
        "SELECT contrato_id, cliente, CASE tipo WHEN 'desconto_vencido' THEN 'Desconto vencido' WHEN 'preco_abaixo' THEN 'Preço abaixo do contratado' WHEN 'reajuste_nao_aplicado' THEN 'Reajuste não aplicado' ELSE 'Mínimo não cobrado' END AS tipo, vazamento_acumulado, vazamento_mes_atual, recuperavel_12_meses\n",
        "FROM vazamento_por_contrato\n",
        "ORDER BY recuperavel_12_meses DESC, vazamento_acumulado DESC\n",
        "LIMIT 20\n"
      ]
    },
    {
      "name": "qualidade",
      "displayName": "Qualidade da extração",
      "queryLines": [
        "SELECT documentos, campos, campos_automaticos / campos AS automatico, campos_revisados, campos_pendentes,\n",
        "       acerto_medido_na_auditoria, auditoria_revisada\n",
        "FROM qualidade_extracao\n"
      ]
    }
  ],
